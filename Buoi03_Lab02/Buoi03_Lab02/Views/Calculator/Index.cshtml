@{
	ViewData["Title"] = "Index";
}

<h1>Calculator</h1>
<form asp-action="Calculate" asp-controller="Calculator">
	<input value="@ViewBag.SoHang01" type="number" name="SoHang01" placeholder="Enter first number" required />
	<select name="ToanTu">
		<option value="+">+</option>
		<option value="-">-</option>
		<option value="*">*</option>
		<option value="/">/</option>
		<option value="%">%</option>
		<option value="^">^</option>
	</select>
	<input value="@ViewBag.SoHang02" type="number" name="SoHang02" placeholder="Enter second number" required />
	<button type="submit">=</button>
	<span class="text-danger">@ViewBag.KetQua</span>
	<div class="text-danger">@ViewBag.ErrorMessage</div>
</form>
@section Scripts {
	<script>
		$(document).ready(function() {
			$("select[name='ToanTu']").val("@ViewBag.ToanTu");
		});
	</script>
}
